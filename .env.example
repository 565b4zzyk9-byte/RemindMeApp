# Flask
SECRET_KEY=change-this-to-a-random-secret
FLASK_ENV=production

# Azure AD / Microsoft Graph app registration
# Register an app at https://portal.azure.com -> Azure Active Directory -> App registrations
# Redirect URI (Web): http://localhost:5000/auth/callback
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=your-client-secret-value
TENANT_ID=your-tenant-id-or-domain.onmicrosoft.com
# Delegated scopes requested at login. offline_access lets the app refresh
# tokens in the background so the daily digest can be sent without the user
# being logged in at the time.
GRAPH_SCOPES=User.Read Mail.Send offline_access

# Where the app is hosted, used to build the OAuth redirect URI
APP_BASE_URL=http://localhost:5000

# Database. A relative sqlite:/// path is stored under the app's instance/
# folder; use an absolute path (sqlite:////absolute/path/app.db, 4 slashes)
# or a different DB URL to store it elsewhere.
DATABASE_URL=sqlite:///app.db

# Daily digest schedule (24h clock, in TIMEZONE below), Monday-Friday only
DIGEST_HOUR=8
DIGEST_MINUTE=0
TIMEZONE=UTC

# Set to "0" to disable the background scheduler (e.g. when running behind
# a process manager that runs a separate worker/cron for send_daily_digests)
ENABLE_SCHEDULER=1
